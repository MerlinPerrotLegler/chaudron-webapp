generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Provenance {
  fermiere
  importation
  base
}

enum UniteAchat {
  kg
  L
  piece
}

enum BesoinEau {
  faible
  modere
  eleve
}

enum FamilleRecette {
  sec
  sirop
  sel
  sucre
  vinaigre
  lacto
  moutarde
  tabasco
  tisane
  cosmetique
  autre
}

enum TypeRecette {
  transformation
  simple
}

enum ModeQuantite {
  proportions
  absolu
}

model Espece {
  id                   Int               @id @default(autoincrement())
  nom                  String            @unique
  nomLatin             String?
  famille              String?
  cycle                CycleEspece?
  renouvellementAns    Int?
  phMin                Float?
  phMax                Float?
  typeSol              String?
  exposition           String?
  tempsLeveeMin        Int?
  tempsLeveeMax        Int?
  tempsAvantRepiquage  Int?
  besoinEau            BesoinEau?
  besoinEauLJour       Float?
  besoinEauLMois       Float?
  espacementCm         Float?
  densitePlantsHa      Float?
  rendementTHaFrais    Float?
  rendementKgHaSec     Float?
  amendementNotes      String?           @db.Text
  archivee             Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  matieres             Matiere[]
  itineraires          ItineraireEtape[]
  associations         Association[]     @relation("EspeceSource")
  associationsCibles   Association[]     @relation("EspeceCible")
  risques              RisqueCulture[]
  faisabilites         Faisabilite[]
  lots                 LotCulture[]
}

enum CycleEspece {
  annuelle
  bisannuelle
  vivace
}

enum CodeItineraire {
  semis
  plantation
  recolte
  taille
  division
  autre
}

enum TypeAssociation {
  favorable
  deconseillee
}

enum NiveauFaisabilite {
  vert
  jaune
  rouge
}

enum PrioriteLot {
  P1
  P2
  P3
}

enum EtatLot {
  prevu
  seme
  plante
  en_croissance
  en_recolte
  termine
  abandonne
}

enum QualiteRecolte {
  A
  B
  C
  autre
}

model ItineraireEtape {
  id                         Int            @id @default(autoincrement())
  especeId                   Int
  espece                     Espece         @relation(fields: [especeId], references: [id])
  ordre                      Int            @default(0)
  code                       CodeItineraire
  libelle                    String?
  dureeDepuisPrecedenteJours Int            @default(0)
  fenetreDebutMmdd           String?
  fenetreFinMmdd             String?
  description                String?        @db.Text

  @@index([especeId, ordre])
}

model Association {
  id            Int             @id @default(autoincrement())
  especeId      Int
  espece        Espece          @relation("EspeceSource", fields: [especeId], references: [id])
  especeCibleId Int
  especeCible   Espece          @relation("EspeceCible", fields: [especeCibleId], references: [id])
  type          TypeAssociation
  notes         String?         @db.Text

  @@unique([especeId, especeCibleId, type])
}

model RisqueCulture {
  id          Int     @id @default(autoincrement())
  especeId    Int
  espece      Espece  @relation(fields: [especeId], references: [id])
  nom         String
  description String? @db.Text
  prevention  String? @db.Text

  @@index([especeId])
}

model Faisabilite {
  especeId  Int
  espece    Espece            @relation(fields: [especeId], references: [id])
  vocation  VocationParcelle
  niveau    NiveauFaisabilite
  notes     String?           @db.Text

  @@id([especeId, vocation])
}

model LotCulture {
  id                     Int         @id @default(autoincrement())
  especeId               Int
  espece                 Espece      @relation(fields: [especeId], references: [id])
  plancheId              Int
  planche                Planche     @relation(fields: [plancheId], references: [id])
  annee                  Int
  surfaceM2              Float
  priorite               PrioriteLot @default(P2)
  rendementTHaFraisReel  Float?
  rendementKgHaSecReel   Float?
  notes                  String?     @db.Text
  etat                   EtatLot     @default(prevu)
  archive                Boolean     @default(false)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  etapes                 LotEtape[]
  recoltes               Recolte[]

  @@index([plancheId, annee])
  @@index([especeId, annee])
}

model LotEtape {
  id                         Int       @id @default(autoincrement())
  lotId                      Int
  lot                        LotCulture @relation(fields: [lotId], references: [id])
  ordre                      Int       @default(0)
  code                       CodeItineraire
  libelle                    String?
  dureeDepuisPrecedenteJours Int       @default(0)
  fenetreDebutMmdd           String?
  fenetreFinMmdd             String?
  description                String?   @db.Text
  datePrevue                 DateTime? @db.Date
  verrouillee                Boolean   @default(false)
  decouplee                  Boolean   @default(false)
  dateReelle                 DateTime? @db.Date
  fait                       Boolean   @default(false)

  @@index([lotId, ordre])
}

model Recolte {
  id              Int             @id @default(autoincrement())
  lotId           Int
  lot             LotCulture      @relation(fields: [lotId], references: [id])
  date            DateTime        @db.Date
  poidsKg         Float
  qualite         QualiteRecolte  @default(A)
  qualiteNotes    String?
  numerosSacs     Json?
  emplacement     String?
  datePeremption  DateTime?       @db.Date
  campagneId      String?
  notes           String?         @db.Text
  operateurNom    String?
  matiereId       Int
  matiere         Matiere         @relation(fields: [matiereId], references: [id])
  stockMouvementId Int?
  createdAt       DateTime        @default(now())

  @@index([lotId, date])
  @@index([campagneId])
}

model Matiere {
  id           Int                 @id @default(autoincrement())
  nom          String              @unique
  nomLatin     String?
  provenance   Provenance
  uniteAchat   UniteAchat          @default(kg)
  ratioSechage Float?
  pctEau       Float?
  besoinEau    BesoinEau?
  source       String?
  fournisseur  String?
  lien         String?
  prixVenteKg  Float?
  stockMini    Float?
  especeId     Int?
  espece       Espece?             @relation(fields: [especeId], references: [id])
  archivee     Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  prix         MatierePrix[]
  ingredients  RecetteIngredient[]
  recoltes     Recolte[]
  lotsStock    LotStockMatiere[]
  achats       Achat[]
  transfoOut   Transformation[]        @relation("TransfoOut")
  transfoLignes TransformationLigneIn[]
  prodLignes   ProductionLigneMatiere[]
}

model MatierePrix {
  id        Int      @id @default(autoincrement())
  matiereId Int
  matiere   Matiere  @relation(fields: [matiereId], references: [id])
  date      DateTime @db.Date
  prix      Float
  createdAt DateTime @default(now())

  @@index([matiereId, date])
}

model CategorieReglementaire {
  id        Int       @id @default(autoincrement())
  nom       String    @unique
  lienFiche String?
  recettes  Recette[]
}

model Recette {
  id                    Int                 @id @default(autoincrement())
  nom                   String              @unique
  description           String?             @db.Text
  tags                  Json?
  famille               FamilleRecette
  type                  TypeRecette         @default(transformation)
  categorieId           Int?
  categorie             CategorieReglementaire? @relation(fields: [categorieId], references: [id])
  modeQuantite          ModeQuantite        @default(proportions)
  quantiteSortie        Float?
  uniteSortie           String?
  lotRefLibelle         String?
  rendementRatioTravail Float               @default(1)
  notesVariante         String?             @db.Text
  archivee              Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  ingredients           RecetteIngredient[]
  etapes                EtapeRecette[]
  produits              ProduitFini[]
  productions           Production[]
}

model RecetteIngredient {
  id          Int     @id @default(autoincrement())
  recetteId   Int
  recette     Recette @relation(fields: [recetteId], references: [id])
  matiereId   Int
  matiere     Matiere @relation(fields: [matiereId], references: [id])
  ordre       Int     @default(0)
  quantite    Float
  unite       String
  poidsEquivG Float?
}

model EtapeRecette {
  id              Int               @id @default(autoincrement())
  recetteId       Int
  recette         Recette           @relation(fields: [recetteId], references: [id])
  ordre           Int               @default(0)
  description     String            @db.Text
  tempsMainOeuvre Int               @default(0)
  tempsAttente    Int               @default(0)
  parametres      Json?
  equipements     EtapeEquipement[]
}

model Equipement {
  id     Int               @id @default(autoincrement())
  nom    String            @unique
  etapes EtapeEquipement[]
}

model EtapeEquipement {
  etapeId      Int
  equipementId Int
  etape        EtapeRecette @relation(fields: [etapeId], references: [id])
  equipement   Equipement   @relation(fields: [equipementId], references: [id])

  @@id([etapeId, equipementId])
}

model Conditionnement {
  id            Int           @id @default(autoincrement())
  nom           String        @unique
  contenance    Float?
  poidsNet      Float?
  coutContenant Float         @default(0)
  coutBouchon   Float         @default(0)
  coutEtiquette Float         @default(0)
  coutTotal     Float         @default(0)
  lienContenant String?
  lienBouchon   String?
  archive       Boolean       @default(false)
  produits      ProduitFini[]
}

model ProduitFini {
  id                Int             @id @default(autoincrement())
  recetteId         Int
  recette           Recette         @relation(fields: [recetteId], references: [id])
  conditionnementId Int
  conditionnement   Conditionnement @relation(fields: [conditionnementId], references: [id])
  poidsUnite        Float
  prixVenteUnite    Float?
  stockMini         Float?
  actif             Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lotsStock         LotStockProduit[]
  productionSorties ProductionSortie[]
}

model Parametres {
  id                    Int     @id @default(1)
  tauxHoraireMainOeuvre Float   @default(0)
  inclureMo             Boolean @default(true)
  seuilJoursAlerteDluo  Int     @default(30)
}

// ——— Domaine E : Culture (Plan E1) ———

enum VocationParcelle {
  serre_semis
  tunnel
  frais
  maraichage
  draine_ensoleille
  grande_culture
  autre
}

enum TypeEntrant {
  compost
  amendement
  fertilisation
  phyto
  irrigation
  semence_plant
  autre
}

model Parcelle {
  id             Int               @id @default(autoincrement())
  code           String            @unique
  vocation       VocationParcelle
  typeSol        String?
  ph             Float?
  drainage       String?
  pierrosite     String?
  exposition     String?
  pente          String?
  particularites String?           @db.Text
  surfaceM2      Float?
  archivee       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  planches       Planche[]
}

model Planche {
  id             Int            @id @default(autoincrement())
  parcelleId     Int
  parcelle       Parcelle       @relation(fields: [parcelleId], references: [id])
  numero         String
  code           String         @unique
  surfaceM2      Float
  particularites String?        @db.Text
  archivee       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  travauxSol     TravailSol[]
  entrants       Entrant[]
  images         PlancheImage[]
  jours          PlancheJour[]
  lots           LotCulture[]

  @@unique([parcelleId, numero])
}

model TravailSol {
  id          Int      @id @default(autoincrement())
  plancheId   Int
  planche     Planche  @relation(fields: [plancheId], references: [id])
  date        DateTime @db.Date
  type        String
  description String?  @db.Text
  operateurNom String?
  createdAt   DateTime @default(now())

  @@index([plancheId, date])
}

model Entrant {
  id              Int         @id @default(autoincrement())
  plancheId       Int
  planche         Planche     @relation(fields: [plancheId], references: [id])
  date            DateTime    @db.Date
  type            TypeEntrant
  produit         String
  quantite        Float?
  unite           String?
  refGaine        String?
  refSemencePlant String?
  operateurNom    String?
  createdAt       DateTime    @default(now())

  @@index([plancheId, date])
}

model PlancheImage {
  id            Int      @id @default(autoincrement())
  plancheId     Int
  planche       Planche  @relation(fields: [plancheId], references: [id])
  cheminFichier String
  legende       String?
  ordre         Int      @default(0)
  uploadedAt    DateTime @default(now())

  @@index([plancheId])
}

model PlancheJour {
  plancheId Int
  planche   Planche  @relation(fields: [plancheId], references: [id])
  date      DateTime @db.Date
  notes     String   @db.Text

  @@id([plancheId, date])
}

// ——— Domaine C : Production & transformation ———

enum TypeTransformation {
  sechage
  distillation
  mondage
  congelation
  torrefaction
  autre
}

enum StatutOperation {
  brouillon
  en_cours
  terminee
  annulee
}

enum StatutEtapeProd {
  a_faire
  en_cours
  termine
}

model Transformation {
  id                  Int                 @id @default(autoincrement())
  type                TypeTransformation
  typeLibelle         String?
  date                DateTime            @db.Date
  parametres          Json?
  matiereOutId        Int
  matiereOut          Matiere              @relation("TransfoOut", fields: [matiereOutId], references: [id])
  quantiteOut         Float
  uniteOut            UniteAchat
  rendement           Float?
  emplacementOutId    Int?
  datePeremptionOut   DateTime?           @db.Date
  lotStockMatiereOutId Int?
  operateurNom        String?
  notes               String?             @db.Text
  statut              StatutOperation     @default(terminee)
  createdAt           DateTime            @default(now())
  lignesIn            TransformationLigneIn[]
}

model TransformationLigneIn {
  id               Int            @id @default(autoincrement())
  transformationId Int
  transformation   Transformation @relation(fields: [transformationId], references: [id])
  matiereId        Int
  matiere          Matiere        @relation(fields: [matiereId], references: [id])
  quantite         Float
  notes            String?
}

model Production {
  id                   Int               @id @default(autoincrement())
  recetteId            Int
  recette              Recette           @relation(fields: [recetteId], references: [id])
  date                 DateTime          @db.Date
  numeroLot            String            @unique
  facteurEchelle       Float             @default(1)
  quantiteSortieVisee  Float?
  poidsKg              Float?
  datePeremption       DateTime?         @db.Date
  operateurNom         String?
  statut               StatutOperation   @default(brouillon)
  notes                String?           @db.Text
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  lignesMatiere        ProductionLigneMatiere[]
  sorties              ProductionSortie[]
  etapes               ProductionEtape[]
}

model ProductionLigneMatiere {
  id              Int        @id @default(autoincrement())
  productionId    Int
  production      Production @relation(fields: [productionId], references: [id])
  matiereId       Int
  matiere         Matiere    @relation(fields: [matiereId], references: [id])
  quantiteRequise Float
  poidsKgConsomme Float?
  notes           String?
}

model ProductionSortie {
  id               Int        @id @default(autoincrement())
  productionId     Int
  production       Production @relation(fields: [productionId], references: [id])
  produitFiniId    Int
  produitFini      ProduitFini @relation(fields: [produitFiniId], references: [id])
  quantiteUnites   Float
  poidsKg          Float?
  notes            String?
  datePeremption   DateTime?  @db.Date
  emplacementId    Int?
  lotStockProduitId Int?
}

model ProductionEtape {
  id                     Int             @id @default(autoincrement())
  productionId           Int
  production             Production      @relation(fields: [productionId], references: [id])
  etapeRecetteId         Int?
  ordre                  Int             @default(0)
  description            String          @db.Text
  tempsMainOeuvrePrevuMin Int            @default(0)
  tempsAttentePrevuMin   Int             @default(0)
  statut                 StatutEtapeProd @default(a_faire)
  poidsKg                Float?
  notes                  String?         @db.Text
  startedAt              DateTime?
  finishedAt             DateTime?
}

// ——— Domaine D : Stock ———

enum SourceLotMatiere {
  recolte
  achat
  transformation
  ajustement
  transfert
}

enum SourceLotProduit {
  production
  ajustement
  transfert
}

enum SensMouvement {
  entree
  sortie
  ajustement
  transfert
}

enum CibleMouvement {
  matiere
  produit
}

model Emplacement {
  id        Int               @id @default(autoincrement())
  nom       String            @unique
  notes     String?
  archive   Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  lotsMatiere LotStockMatiere[]
  lotsProduit LotStockProduit[]
  achats    Achat[]
  mouvements Mouvement[]
}

model LotStockMatiere {
  id                Int              @id @default(autoincrement())
  matiereId         Int
  matiere           Matiere          @relation(fields: [matiereId], references: [id])
  emplacementId     Int?
  emplacement       Emplacement?     @relation(fields: [emplacementId], references: [id])
  quantiteInitiale  Float
  quantiteRestante  Float
  unite             UniteAchat
  dateEntree        DateTime         @db.Date
  datePeremption    DateTime?        @db.Date
  numerosSacs       Json?
  coutUnitaire      Float?
  sourceType        SourceLotMatiere
  sourceId          Int?
  recolteId         Int?
  achatId           Int?             @unique
  achat             Achat?           @relation(fields: [achatId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  mouvements        Mouvement[]

  @@index([matiereId, quantiteRestante])
  @@index([datePeremption])
}

model LotStockProduit {
  id                  Int              @id @default(autoincrement())
  produitFiniId       Int
  produitFini         ProduitFini      @relation(fields: [produitFiniId], references: [id])
  emplacementId       Int?
  emplacement         Emplacement?     @relation(fields: [emplacementId], references: [id])
  quantiteInitiale    Float
  quantiteRestante    Float
  dateEntree          DateTime         @db.Date
  datePeremption      DateTime?        @db.Date
  numeroLotProduction String?
  poidsKg             Float?
  notes               String?          @db.Text
  sourceType          SourceLotProduit
  sourceId            Int?
  productionId        Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  mouvements          Mouvement[]

  @@index([produitFiniId, quantiteRestante])
}

model Mouvement {
  id            Int            @id @default(autoincrement())
  date          DateTime       @db.Date
  sens          SensMouvement
  cible         CibleMouvement
  lotMatiereId  Int?
  lotMatiere    LotStockMatiere? @relation(fields: [lotMatiereId], references: [id])
  lotProduitId  Int?
  lotProduit    LotStockProduit? @relation(fields: [lotProduitId], references: [id])
  quantite      Float
  emplacementId Int?
  emplacement   Emplacement?   @relation(fields: [emplacementId], references: [id])
  motif         String?
  operateurNom  String?
  refType       String?
  refId         Int?
  createdAt     DateTime       @default(now())

  @@index([date])
  @@index([lotMatiereId])
  @@index([lotProduitId])
}

model Achat {
  id                   Int              @id @default(autoincrement())
  matiereId            Int
  matiere              Matiere          @relation(fields: [matiereId], references: [id])
  date                 DateTime         @db.Date
  quantite             Float
  prixUnitaire         Float
  devise               String           @default("EUR")
  fournisseur          String?
  lien                 String?
  emplacementId        Int?
  emplacement          Emplacement?     @relation(fields: [emplacementId], references: [id])
  datePeremption       DateTime?        @db.Date
  ajouterPrixCatalogue Boolean          @default(true)
  operateurNom         String?
  createdAt            DateTime         @default(now())
  lotStockMatiere      LotStockMatiere?
}

