# Copier vers .env (dev local) — ne jamais commiter les vraies valeurs.
# Production Hostinger : variables dans hPanel uniquement.

# MySQL distant (hPanel → Bases de données → MySQL)
# Format : mysql://USER:PASSWORD@HOST:3306/NOM_BASE
# Host typique Hostinger : quelque chose comme mysql.hostinger.com (voir hPanel)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/chaudron"

# Clé d'API pour les intégrations (header x-api-key) — login/session plus tard
API_KEY="change-me"

# Config webhooks (événement → [urls])
WEBHOOKS_CONFIG_PATH="./webhooks.config.json"
