# Copier vers .env (dev) — ne jamais commiter les vraies valeurs.
# En production Hostinger : définir ces variables dans hPanel, pas ici.

# Base de données MySQL/MariaDB
DATABASE_URL="mysql://user:password@localhost:3306/chaudron"

# Clé d'API pour les intégrations externes
API_KEY="change-me"

# Chemin du fichier de configuration des webhooks (nom.du.hook -> [urls])
WEBHOOKS_CONFIG_PATH="./webhooks.config.json"
